# HuggingFace token (required) — accept the user agreement on
# https://huggingface.co/pyannote/speaker-diarization-3.1
# https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxx

# Server
HOST=0.0.0.0
PORT=8000

# Model
WHISPER_MODEL=large-v3-turbo
COMPUTE_TYPE=int8
DEVICE=cpu

# Limits
MAX_UPLOAD_MB=200

# Speaker verification (ECAPA-TDNN via SpeechBrain)
VERIFY_MODEL=speechbrain/spkrec-ecapa-voxceleb
# Path to the JSON-backed speaker gallery (created on first enrollment).
SPEAKER_GALLERY_PATH=gallery.json
# Cosine threshold (on unit-normalized embeddings) above which a match is accepted.
IDENTIFY_THRESHOLD=0.55
